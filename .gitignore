/target
/launchd
node_modules/
stocks.db
stocks.db-wal
stocks.db-shm
web/.vite/
web/coverage/
web/dist/
.claude/settings.local.json

# Point-in-time database backups taken before migrations — about 1 GB and
# growing, and reproducible only in the sense that they are snapshots of local
# state. They live in backups/; the root patterns catch one taken the old way.
backups/
stocks-backup-*.db
stocks-backup-*.db-wal
stocks-backup-*.db-shm

# Generated CSV exports and one-off HTML analysis reports.
exports/
*-report.html
*-report-v2.html

# Manual backups taken before a data change; each is a full copy of stocks.db.
stocks.db.bak-*
